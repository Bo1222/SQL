# Copy to .env and fill in locally. Never commit the real .env file.
# All values here are placeholders; keep them empty or fictional.

# Weights & Biases (leave WANDB_MODE=offline for local/offline runs)
WANDB_API_KEY=
WANDB_MODE=offline
WANDB_PROJECT=sqlrl
WANDB_ENTITY=

# Optional overrides
# WANDB_NAME=
# WANDB_DIR=

# Optional teacher-trace provider, used only by the GLM collection scripts
GLM_API_KEY=
